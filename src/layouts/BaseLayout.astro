---
import "../styles/global.css"
import "katex/dist/katex.min.css"
import { getVaultGraph } from "../lib/vault"

interface Props {
  title: string
  description?: string
  canonicalPath?: string
  activeDomain?: string
  noindex?: boolean
  showMobileMenu?: boolean
  isArticle?: boolean
  publishedIso?: string
  modifiedIso?: string
  tags?: string[]
  keywords?: string[]
}

const {
  title,
  description = "李浩鹏（汀）的技术知识库：Linux 内核与性能工程、分布式存储与计算、云原生、可观测性与 SRE 实践。",
  canonicalPath = "/",
  activeDomain = "",
  noindex = false,
  showMobileMenu = false,
  isArticle = false,
  publishedIso,
  modifiedIso,
  tags = [],
  keywords = [],
} = Astro.props

const graph = getVaultGraph()
const siteUrl = "https://ting.is-a.dev"
const fullTitle = title === "汀的知识碎片" ? title : `${title} · 汀的知识碎片`
const canonicalUrl = new URL(canonicalPath, siteUrl).toString()

const TOP_DOMAINS = graph.domains

const jsonLd = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description,
      inLanguage: "zh-CN",
      url: canonicalUrl,
      datePublished: publishedIso,
      dateModified: modifiedIso ?? publishedIso,
      keywords: [...new Set([...tags, ...keywords])].join(", ") || undefined,
      author: { "@type": "Person", name: "李浩鹏（汀）", url: "https://github.com/hpliStartAgain" },
    }
  : undefined
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-font-size="md" data-width="normal" data-focus="false">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161614" />
    <link rel="alternate" type="application/rss+xml" title="汀的知识碎片" href="/index.xml" />

    <meta property="og:site_name" content="汀的知识碎片" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}

    <!-- Async Google Fonts with safe local Chinese fallback -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@600;700&display=swap"
      />
    </noscript>

    <!-- Prevent theme & reading prefs flash -->
    <script is:inline>
      ;(function () {
        try {
          var root = document.documentElement
          var savedTheme = localStorage.getItem("ting-theme")
          var theme =
            savedTheme === "dark" || savedTheme === "light"
              ? savedTheme
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
          root.setAttribute("data-theme", theme)
          var fs = localStorage.getItem("ting-font-size")
          if (fs === "sm" || fs === "md" || fs === "lg") root.setAttribute("data-font-size", fs)
          var wd = localStorage.getItem("ting-width")
          if (wd === "normal" || wd === "wide") root.setAttribute("data-width", wd)
          var fc = localStorage.getItem("ting-focus")
          if (fc === "true") root.setAttribute("data-focus", "true")
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="header-left">
          {
            showMobileMenu && (
              <button
                type="button"
                id="mobile-menu-btn"
                class="icon-btn mobile-menu-btn"
                title="展开专栏目录"
                aria-label="展开专栏目录"
              >
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="3" x2="21" y1="6" y2="6" />
                  <line x1="3" x2="21" y1="12" y2="12" />
                  <line x1="3" x2="21" y1="18" y2="18" />
                </svg>
              </button>
            )
          }
          <a href="/" class="brand-link">
            <img src="/favicon.svg" class="brand-icon" width="24" height="24" alt="" aria-hidden="true" />
            <span>汀的知识碎片</span>
          </a>
          <nav class="header-domains" aria-label="知识领域">
            {
              TOP_DOMAINS.map((d) => (
                <a
                  href={d.href}
                  class:list={["domain-pill", { "is-active": activeDomain === d.name }]}
                >
                  {d.name}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="header-actions">
          <button type="button" id="search-trigger-btn" class="search-trigger" title="全文搜索 (⌘K)">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span>搜索</span>
            <kbd>⌘K</kbd>
          </button>

          <div class="prefs-wrapper">
            <button
              type="button"
              id="prefs-toggle-btn"
              class="icon-btn"
              title="排版与阅读设置"
              aria-label="排版与阅读设置"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7V4h16v3" />
                <path d="M9 20h6" />
                <path d="M12 4v16" />
              </svg>
            </button>

            <div id="prefs-popover" class="prefs-popover" hidden>
              <div class="prefs-group">
                <span class="prefs-label">正文字号</span>
                <div class="prefs-segmented">
                  <button type="button" data-pref-group="fontSize" data-pref-value="sm">紧凑</button>
                  <button type="button" data-pref-group="fontSize" data-pref-value="md">标准</button>
                  <button type="button" data-pref-group="fontSize" data-pref-value="lg">舒适大</button>
                </div>
              </div>
              <div class="prefs-group">
                <span class="prefs-label">版心宽度</span>
                <div class="prefs-segmented">
                  <button type="button" data-pref-group="width" data-pref-value="normal">72 字宽</button>
                  <button type="button" data-pref-group="width" data-pref-value="wide">宽幅阅读</button>
                </div>
              </div>
            </div>
          </div>

          {
            isArticle && (
              <button
                type="button"
                id="focus-toggle-btn"
                class="icon-btn"
                title="专注阅读模式（收起侧栏）"
                aria-label="专注阅读模式"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3" />
                  <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
                  <path d="M3 16v3a2 2 0 0 0 2 2h3" />
                  <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
                </svg>
              </button>
            )
          }

          <button
            type="button"
            id="theme-toggle-btn"
            class="icon-btn"
            title="切换浅色 / 深色主题"
            aria-label="切换主题"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© {new Date().getFullYear()} 李浩鹏（汀）</span>
        <div class="footer-links">
          <a href="/tags">全部标签</a>
          <a href="/index.xml">RSS 订阅</a>
          <a href="https://github.com/hpliStartAgain" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://github.com/hpliStartAgain/my-brain" target="_blank" rel="noopener noreferrer">站点源码</a>
        </div>
      </div>
    </footer>

    <!-- Global Search Modal -->
    <div id="search-modal" class="search-modal" hidden role="dialog" aria-modal="true" aria-label="全站搜索">
      <div class="search-dialog">
        <div class="search-input-wrap">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="搜索文章标题、专栏、标签或正文关键词…"
            autocomplete="off"
          />
          <span style="font-size:0.75rem;color:var(--text-faint)">ESC 关闭</span>
        </div>
        <div id="search-results" class="search-results">
          <div class="search-empty">输入关键词检索 1,200+ 篇专栏正文、标题或标签</div>
        </div>
      </div>
    </div>

    <!-- Global Diagram / Image Lightbox Modal -->
    <div id="diagram-modal" class="diagram-modal" hidden role="dialog" aria-modal="true" aria-label="图表预览">
      <div class="diagram-modal-bar">
        <span class="diagram-modal-hint">滚轮缩放 · 拖拽平移 · ESC 退出</span>
        <div class="diagram-modal-controls">
          <button type="button" class="mm-btn" data-modal-zoom-out>－</button>
          <button type="button" class="mm-btn" data-modal-fit>适配视口</button>
          <button type="button" class="mm-btn" data-modal-reset>100%</button>
          <button type="button" class="mm-btn" data-modal-zoom-in>＋</button>
          <button type="button" class="mm-btn" data-modal-close>关闭</button>
        </div>
      </div>
      <div class="diagram-modal-viewport" data-modal-viewport>
        <div class="diagram-modal-canvas" data-modal-canvas></div>
      </div>
    </div>

    <!-- Wikilink Hover Popover -->
    <div id="link-popover" class="link-popover" hidden>
      <div class="link-popover-col" data-pop-col></div>
      <div class="link-popover-title" data-pop-title></div>
      <div class="link-popover-summary" data-pop-summary></div>
    </div>

    <script>
      import { initReadingPrefs } from "../scripts/reading-prefs"
      import { initSearchModal } from "../scripts/search-modal"
      import { initArticleEnhancements } from "../scripts/article-enhance"

      initReadingPrefs()
      initSearchModal()
      initArticleEnhancements()

      if (document.querySelector("[data-mermaid-block]")) {
        import("../scripts/mermaid-runtime").then((mod) => mod.initMermaidRuntime())
      }
    </script>
  </body>
</html>
