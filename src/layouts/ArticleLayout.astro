---
import BaseLayout from "./BaseLayout.astro"
import SidebarFolderTree from "../components/SidebarFolderTree.astro"
import type { VaultFolder, VaultGraph, VaultNote } from "../lib/vault"
import type { TocItem } from "../lib/markdown"

interface Props {
  note: VaultNote
  graph: VaultGraph
  html: string
  toc: TocItem[]
}

const { note, graph, html, toc } = Astro.props

const currentFolder = graph.folders.get(note.folderPath)

// If current folder sits inside a multi-module column (not a top-level domain)
// and that column has a reasonable size (<= 60 notes), promote sidebar root to
// the column root so all sibling modules are directly expandable in the sidebar.
let sidebarRootFolder: VaultFolder | undefined = currentFolder
if (currentFolder?.parentPath && currentFolder.parentPath.includes("/")) {
  const parentCandidate = graph.folders.get(currentFolder.parentPath)
  if (parentCandidate && parentCandidate.totalNotes <= 60) {
    sidebarRootFolder = parentCandidate
  }
} else if (
  currentFolder?.parentPath &&
  !currentFolder.parentPath.includes("/") &&
  currentFolder.folderPath.split("/").length === 3
) {
  // Depth-3 folders like "LLM/Agent沙箱技术/隔离原语": parent is "LLM/Agent沙箱技术"
  // (already handled by parentPath.includes("/") above). Keep explicit clarity.
}

const parentOfRoot = sidebarRootFolder?.parentPath
  ? graph.folders.get(sidebarRootFolder.parentPath)
  : null

function flattenFolderNotes(f: VaultFolder): VaultNote[] {
  const result: VaultNote[] = [...f.notes]
  for (const childPath of f.childFolders) {
    const child = graph.folders.get(childPath)
    if (child) result.push(...flattenFolderNotes(child))
  }
  return result
}

const columnNotes = sidebarRootFolder ? flattenFolderNotes(sidebarRootFolder) : [note]
const currentIndex = columnNotes.findIndex((n) => n.slug === note.slug)
const prevNote = currentIndex > 0 ? columnNotes[currentIndex - 1] : null
const nextNote =
  currentIndex >= 0 && currentIndex < columnNotes.length - 1 ? columnNotes[currentIndex + 1] : null

const backlinkNotes = (graph.backlinks.get(note.slug) ?? []).slice(0, 12)

const pathParts = note.folderPath ? note.folderPath.split("/") : []
const crumbs = pathParts.map((part, idx) => {
  const fPath = pathParts.slice(0, idx + 1).join("/")
  const fObj = graph.folders.get(fPath)
  return {
    label: part,
    href: fObj?.href ?? "/",
  }
})
---

<BaseLayout
  title={note.title}
  description={note.summary || `${note.title} · ${note.folderPath}`}
  canonicalPath={note.href}
  activeDomain={note.domain}
  showMobileMenu={true}
  isArticle={true}
  publishedIso={note.date}
  tags={note.tags}
  keywords={note.keywords}
>
  <div class="reading-progress-track" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <div class="article-shell">
    <!-- Left Expandable Scoped Column Sidebar -->
    <aside class="column-sidebar" aria-label="本专栏目录">
      <div class="sidebar-col-head">
        {
          parentOfRoot ? (
            <a href={parentOfRoot.href} class="sidebar-domain-crumb">
              ← {parentOfRoot.name}
            </a>
          ) : (
            <a href="/" class="sidebar-domain-crumb">
              ← 返回知识库首页
            </a>
          )
        }
        <a href={sidebarRootFolder?.href ?? "/"} class="sidebar-col-title">
          {sidebarRootFolder?.name || note.domain || "专栏文章"}
        </a>
        <div class="sidebar-col-count">
          本栏共 {columnNotes.length} 篇{currentIndex >= 0 ? ` · 当前第 ${currentIndex + 1} 篇` : ""}
        </div>
      </div>

      {
        sidebarRootFolder ? (
          <SidebarFolderTree
            folder={sidebarRootFolder}
            graph={graph}
            activeSlug={note.slug}
            activeFolderPath={note.folderPath}
          />
        ) : (
          <ul class="sidebar-nav-list">
            <li>
              <a href={note.href} class="sidebar-nav-link is-active">
                {note.title}
              </a>
            </li>
          </ul>
        )
      }
    </aside>

    <!-- Center Prose -->
    <main class="article-main" data-pagefind-body>
      <span hidden data-pagefind-meta={`column:${note.folderPath || note.domain || "随笔"}`}></span>

      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">首页</a>
        {
          crumbs.map((c) => (
            <>
              <span class="sep">/</span>
              <a href={c.href}>{c.label}</a>
            </>
          ))
        }
      </nav>

      <header class="article-header">
        {
          note.tags.length > 0 && (
            <div class="article-tags-top">
              {note.tags.slice(0, 5).map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}`} class="article-tag-top">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
        <h1 class="article-title" data-pagefind-meta="title">{note.title}</h1>
        <div class="article-meta-row">
          <div class="article-meta-items">
            <span class="meta-pill">更新于 {note.date}</span>
            <span class="meta-pill">·</span>
            <span class="meta-pill">约 {note.wordCount.toLocaleString("zh-CN")} 字</span>
            <span class="meta-pill">·</span>
            <span class="meta-pill">预计阅读 {note.readingMinutes} 分钟</span>
          </div>
          <button type="button" id="copy-article-btn" class="copy-article-btn">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <span>复制正文</span>
          </button>
        </div>
      </header>

      <article id="article-prose" class="prose" set:html={html} />

      {
        backlinkNotes.length > 0 && (
          <section class="article-backlinks" aria-label="反向链接">
            <h2 class="backlinks-title">引用本文的笔记（{backlinkNotes.length}）</h2>
            <ul class="backlinks-list">
              {backlinkNotes.map((bn) => (
                <li>
                  <a href={bn.href}>↗ {bn.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (prevNote || nextNote) && (
          <nav class="chapter-pager" aria-label="章节连读">
            {prevNote && (
              <a href={prevNote.href} class="pager-card is-prev">
                <span class="pager-dir">← 上一篇</span>
                <span class="pager-title">{prevNote.title}</span>
              </a>
            )}
            {nextNote && (
              <a href={nextNote.href} class="pager-card is-next">
                <span class="pager-dir">下一篇 →</span>
                <span class="pager-title">{nextNote.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </main>

    <!-- Right Sticky TOC -->
    <aside class="toc-sidebar" aria-label="文章大纲">
      {
        toc.length > 0 && (
          <>
            <div class="toc-heading">本页大纲</div>
            <ul class="toc-list">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class:list={["toc-link", `depth-${item.depth}`]}>
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>
  </div>
</BaseLayout>
