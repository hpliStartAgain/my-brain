---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getVaultGraph } from "../lib/vault"

const graph = getVaultGraph()
const totalNotes = graph.notes.filter((n) => !n.isHome).length
const totalWords = graph.notes.reduce((acc, n) => acc + n.wordCount, 0)
const recent = graph.recentNotes.slice(0, 8)
const topTags = Array.from(graph.tags.entries())
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 24)

// Build cross-domain seed pool for SSR first paint (round-robin across domains)
const byDomain = new Map<string, typeof graph.notes>()
for (const n of graph.notes) {
  if (n.isHome || n.summary.length < 25) continue
  const d = n.domain || "随笔"
  const list = byDomain.get(d) ?? []
  list.push(n)
  byDomain.set(d, list)
}
const seedNotes: typeof graph.notes = []
let round = 0
while (seedNotes.length < 48) {
  let pushed = false
  for (const list of byDomain.values()) {
    if (round < list.length) {
      seedNotes.push(list[round])
      pushed = true
      if (seedNotes.length >= 48) break
    }
  }
  if (!pushed) break
  round++
}

const seedRandom = seedNotes.map((n, idx) => ({
  href: n.href,
  title: n.title,
  domain: n.domain || "随笔",
  column: n.folderPath || n.domain || "随笔",
  summary: n.summary,
  num: idx + 1,
}))

const DOMAIN_CARDS = [
  {
    title: "操作系统与底层原理",
    desc: "内核子系统、性能工程与虚拟化实践",
    domain: "Linux",
    links: [
      { label: "进程生命周期与调度器", target: "Linux/进程管理/00 专栏导览" },
      { label: "虚拟内存与 Slab 分配器", target: "Linux/内存管理/00 专栏导览" },
      { label: "VFS、Page Cache 与 IO", target: "Linux/文件系统/00 专栏导览" },
      { label: "TCP/IP 协议栈与 epoll", target: "Linux/网络协议栈与IO/00 专栏导览" },
      { label: "系统性能工程实战 · 15 篇", target: "Linux/系统性能工程实战/00 专栏导览" },
      { label: "KVM 虚拟化与性能工程", target: "Linux/KVM虚拟化与性能工程/00 专栏导览" },
    ],
  },
  {
    title: "编程语言与并发原理",
    desc: "运行时调度、内存分配与数据结构",
    domain: "Golang",
    links: [
      { label: "Go GMP 调度与 Channel", target: "Golang/Go并发编程/00 专栏导览" },
      { label: "Go 运行时 · 分配器与 GC", target: "Golang/Go运行时进阶与底层机制/00 专栏导览" },
      { label: "Go 语言核心 · 语义与控制流", target: "Golang/Go语言核心/00 专栏导览" },
      { label: "JVM 内存模型与 GC 算法", target: "Java/JVM/00 专栏导览" },
      { label: "JMM 与 AQS 并发锁原理", target: "Java/并发编程/00 专栏导览" },
      { label: "数据结构与算法专栏", target: "数据结构与算法/排序与查找/00 专栏导览" },
    ],
  },
  {
    title: "中间件与存储引擎",
    desc: "数据存储、副本复制与高可用核心",
    domain: "中间件",
    links: [
      { label: "MySQL InnoDB 与 MVCC", target: "中间件/MySQL/MySQL架构与底层原理/00 专栏导览" },
      { label: "Redis 数据结构与 Cluster", target: "中间件/Redis/Redis设计与实现/00 专栏导览" },
      { label: "Kafka 分区机制与副本协议", target: "中间件/Kafka/00 专栏导览" },
      { label: "etcd 账本与控制面", target: "中间件/ETCD/00 专栏导览" },
      { label: "Ceph 分布式存储引擎", target: "中间件/Ceph/00 专栏导览" },
      { label: "ClickHouse 列式存储引擎", target: "中间件/Clickhouse/00 专栏导览" },
    ],
  },
  {
    title: "分布式架构与大数据",
    desc: "共识协议、计算引擎与现代数据湖",
    domain: "分布式架构",
    links: [
      { label: "Paxos、Raft 与一致性模型", target: "分布式架构/分布式系统原理与协议/00 专栏导览" },
      { label: "数据密集型系统架构实战", target: "分布式架构/数据密集型系统架构实战/00 专栏导览" },
      { label: "Spark 核心原理与调优", target: "大数据/Spark/Spark-RDD核心原理解析/00 专栏导览" },
      { label: "Flink 状态管理与计算框架", target: "大数据/Flink/Flink原理深度解析与性能优化/00 专栏导览" },
      { label: "HDFS NameNode 与数据节点", target: "大数据/Hadoop/HDFS/00 专栏导览" },
      { label: "数据湖：Iceberg / Hudi / Paimon", target: "大数据/数据湖/Iceberg/00 专栏导览" },
    ],
  },
  {
    title: "云原生与容器编排",
    desc: "Kubernetes 架构、网络数据面与运行时",
    domain: "云原生",
    links: [
      { label: "K8s 架构深度剖析 · 18 篇", target: "云原生/Kubernetes/Kubernetes架构深度剖析/00 专栏导览" },
      { label: "K8s API Server 深度解析", target: "云原生/Kubernetes/kubernetes之API Server/00 专栏导览" },
      { label: "K8s 控制器和调度器", target: "云原生/Kubernetes/kubernetes控制器和调度器/00 专栏导览" },
      { label: "K8s 网络模型与 CNI 插件", target: "云原生/Kubernetes/kubernetes网络原理与插件/00 专栏导览" },
      { label: "云网络数据面与故障定位", target: "云原生/云网络数据面与故障定位/00 专栏导览" },
      { label: "Istio 服务网格与数据面", target: "云原生/服务网格/00 专栏导览" },
    ],
  },
  {
    title: "可观测性与 SRE",
    desc: "监控剖析、集群可靠性与故障复盘",
    domain: "可观测",
    links: [
      { label: "可观测性全景导览", target: "可观测/00 可观测性全景导览" },
      { label: "指标与 VictoriaMetrics", target: "可观测/指标/00 专栏导览" },
      { label: "日志与 Grafana Loki", target: "可观测/日志/00 专栏导览" },
      { label: "持续性能剖析与 eBPF", target: "可观测/Profiler/00 专栏导览" },
      { label: "CVM 集群可靠性工程", target: "SRE/CVM集群可靠性工程/00 专栏导览" },
      { label: "生产故障排查与复盘索引", target: "SRE/故障排查与复盘/00 故障排查索引" },
    ],
  },
  {
    title: "LLM 与 AI 工程",
    desc: "大模型原理、Agent 运行范式与沙箱隔离",
    domain: "LLM",
    links: [
      { label: "Agent 技术与 Coding Agent", target: "LLM/Agent技术/00 专栏导览" },
      { label: "Agent 沙箱技术 · 隔离与安全", target: "LLM/Agent沙箱技术/00 专栏导览" },
      { label: "大模型原理与架构", target: "LLM/LLM原理/00 专栏导览" },
      { label: "Hermes-Agent", target: "LLM/Hermes-Agent/00 专栏导览" },
    ],
  },
  {
    title: "译书与精读",
    desc: "英文经典技术书籍翻译与结构化笔记",
    domain: "译书",
    links: [
      { label: "译书书架总览", target: "译书/00 译书索引" },
      { label: "Systems Performance / 性能之巅", target: "译书/Linux/性能之巅/00 专览导读" },
      { label: "Designing Data-Intensive Applications", target: "译书/分布式/Designing Data-Intensive Applications, 2nd Edition/1 数据系统架构中的权衡" },
      { label: "Software Architecture: The Hard Parts", target: "译书/分布式/Software Architecture - The Hard Parts/00 专栏导览" },
      { label: "Mastering Kubernetes", target: "译书/云原生/Mastering-Kubernetes/_index" },
      { label: "JVM Performance Engineering", target: "译书/Java/JVM-Performance-Engineering/_index" },
    ],
  },
]

const resolvedCards = DOMAIN_CARDS.map((card) => {
  const domainMeta = graph.domains.find((d) => d.name === card.domain)
  return {
    ...card,
    domainHref: domainMeta?.href ?? "/",
    totalNotes: domainMeta?.totalNotes ?? 0,
    resolvedLinks: card.links
      .map((l) => {
        const hit = graph.resolveWikilink(l.target, "")
        return hit.note ? { label: l.label, href: hit.note.href } : null
      })
      .filter((x): x is { label: string; href: string } => Boolean(x)),
  }
})
---

<BaseLayout title="汀的知识碎片" canonicalPath="/">
  <main class="home-container">
    <section class="hero-section">
      <div class="hero-grid">
        <div class="hero-intro">
          <div class="hero-eyebrow">SYSTEMS ENGINEERING · DIGITAL GARDEN</div>
          <h1 class="hero-title">李浩鹏（汀）</h1>
          <p class="hero-lead">
            基础设施研发 / SRE，现居北京。关注云原生沙箱运行时、分布式存储与计算集群、可观测体系与系统级性能工程。
          </p>

          <div class="hero-bio">
            <p>
              这里是我梳理系统认知与工程实践的数字花园。支撑我一路敲代码与钻研的，往往不是宏大的职业叙事，而是从小就有的、对「事物底层究竟如何运转」的原始好奇。
            </p>
            <p>
              这里的专栏不搬运零散的速成笔记，也不做居高临下的布道，只记录我真正拆解过、在生产中踩坑验证过，或深入源码搞清楚的硬核机理——从
              Linux 内核子系统与并发模型，到分布式协议、大数据引擎与现代沙箱隔离。
            </p>
          </div>

          <div class="hero-actions">
            <a href="/roadmap" class="pill-link">学习路线图 →</a>
            <a href="/Linux" class="pill-link">从操作系统开始</a>
            <a href="/分布式架构" class="pill-link">分布式系统专栏</a>
            <a href="/tags" class="pill-link">按标签浏览</a>
            <a href="/index.xml" class="pill-link">RSS 订阅</a>
          </div>

          <div class="stats-strip">
            <span><strong>{totalNotes.toLocaleString("zh-CN")}</strong> 篇深度笔记</span>
            <span><strong>{graph.domains.length}</strong> 个知识领域</span>
            <span><strong>{Math.round(totalWords / 10000).toLocaleString("zh-CN")} 万+</strong> 总字数</span>
          </div>
        </div>

        <aside class="shards-board" aria-label="随机知识碎片">
          <div class="shards-board-head">
            <div class="shards-board-title">
              <span class="shard-diamond" aria-hidden="true"></span>
              <span>随机碎片</span>
              <span class="shards-board-meta">全库 {totalNotes} 篇随机漫游</span>
            </div>
            <button type="button" id="shuffle-random-btn" class="shards-refresh-btn">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.1">
                <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
                <path d="M8 16H3v5" />
              </svg>
              <span>换一批</span>
            </button>
          </div>

          <div id="random-cards-box" class="shards-stage">
            {
              seedRandom.slice(0, 4).map((item, idx) => (
                <a href={item.href} class:list={["shard-card", `shard-slot-${idx}`]}>
                  <div class="shard-card-top">
                    <span class="shard-pin" aria-hidden="true" />
                    <span class="shard-col">{item.column}</span>
                  </div>
                  <div class="shard-title">{item.title}</div>
                  <div class="shard-summary">{item.summary}</div>
                  <div class="shard-foot">
                    <span>SHARD · {String(item.num).padStart(3, "0")}</span>
                    <span class="shard-arrow">→</span>
                  </div>
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <section aria-label="知识领域">
      <div class="section-heading-row">
        <h2 class="section-heading">知识领域与专栏地图</h2>
        <span class="section-sub">点击专栏直达导览与连读目录</span>
      </div>

      <div class="domain-cards-grid">
        {
          resolvedCards.map((card) => (
            <article class="domain-card">
              <div class="domain-card-head">
                <h3 class="domain-card-title">
                  <a href={card.domainHref}>{card.title}</a>
                </h3>
                {card.totalNotes > 0 && <span class="domain-card-count">{card.totalNotes} 篇</span>}
              </div>
              <p class="domain-card-desc">{card.desc}</p>
              <ul class="domain-card-links">
                {card.resolvedLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      <span>{link.label}</span>
                      <span class="col-num">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-split-grid">
      <div>
        <div class="section-heading-row" style="margin-top:0">
          <h2 class="section-heading">最近更新</h2>
          <span class="section-sub">持续迭代</span>
        </div>
        <ul class="recent-list">
          {
            recent.map((item) => (
              <li class="recent-item">
                <a href={item.href}>
                  <div>
                    <span class="recent-item-title">{item.title}</span>
                    <span class="recent-item-col">{item.folderPath || item.domain}</span>
                  </div>
                  <span class="recent-item-date">{item.date}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="section-heading-row" style="margin-top:0">
          <h2 class="section-heading">按标签逛逛</h2>
          <a href="/tags" class="section-sub">查看全部标签 →</a>
        </div>
        <div class="tag-cloud" style="margin-top:0">
          {
            topTags.map(([tag, list]) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-chip">
                #{tag}
                <span>{list.length}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ seedRandom }}>
    window.__tingSeedRandom = seedRandom

    function bootHomeShards() {
      const btn = document.getElementById("shuffle-random-btn")
      const box = document.getElementById("random-cards-box")
      const seeds = window.__tingSeedRandom
      if (!btn || !box || !Array.isArray(seeds) || seeds.length === 0) return
      if (btn.dataset.bound === "true") return
      btn.dataset.bound = "true"

      let fullPool = window.__tingFullPool || null
      let lastHrefs = new Set(seeds.slice(0, 4).map((x) => x.href))

      const BASE_ROTS = [-1.8, 1.9, 1.4, -2.1]
      const BASE_TYS = [2, 10, -2, 6]

      const esc = (s) =>
        String(s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")

      const ensurePool = async () => {
        if (fullPool) return fullPool
        try {
          const res = await fetch("/search-meta.json")
          if (!res.ok) return seeds
          const docs = await res.json()
          const filtered = docs
            .map((d, idx) => ({
              href: d.href,
              title: d.title,
              domain: d.domain || "随笔",
              column: d.column || d.domain || "随笔",
              summary: d.summary || "",
              num: idx + 1,
            }))
            .filter((d) => d.summary.length >= 20)
          if (filtered.length >= 16) {
            fullPool = filtered
            window.__tingFullPool = filtered
            return fullPool
          }
        } catch {}
        return seeds
      }

      const pickDiverseFour = (pool) => {
        const candidates = pool.filter((item) => !lastHrefs.has(item.href))
        const source = candidates.length >= 4 ? candidates : pool.slice()
        for (let i = source.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1))
          const tmp = source[i]
          source[i] = source[j]
          source[j] = tmp
        }

        const picked = []
        const seenDomains = new Set()
        for (const item of source) {
          if (!seenDomains.has(item.domain)) {
            picked.push(item)
            seenDomains.add(item.domain)
            if (picked.length === 4) break
          }
        }
        if (picked.length < 4) {
          for (const item of source) {
            if (!picked.includes(item)) {
              picked.push(item)
              if (picked.length === 4) break
            }
          }
        }
        return picked
      }

      const renderShards = (items, animate) => {
        lastHrefs = new Set(items.map((x) => x.href))
        box.innerHTML = items
          .map((item, idx) => {
            const jitter = animate ? (Math.random() - 0.5) * 1.3 : 0
            const rot = (BASE_ROTS[idx % 4] + jitter).toFixed(2)
            const ty = BASE_TYS[idx % 4]
            const delay = idx * 45
            return `<a href="${esc(item.href)}" class="shard-card shard-slot-${idx}${animate ? " is-entering" : ""}" style="--rot:${rot}deg;--ty:${ty}px;--delay:${delay}ms">
              <div class="shard-card-top">
                <span class="shard-pin" aria-hidden="true"></span>
                <span class="shard-col">${esc(item.column)}</span>
              </div>
              <div class="shard-title">${esc(item.title)}</div>
              <div class="shard-summary">${esc(item.summary)}</div>
              <div class="shard-foot">
                <span>SHARD · ${String(item.num).padStart(3, "0")}</span>
                <span class="shard-arrow">→</span>
              </div>
            </a>`
          })
          .join("")
      }

      ensurePool().then((pool) => {
        if (pool && pool.length > 8) {
          renderShards(pickDiverseFour(pool), false)
        }
      })

      btn.addEventListener("click", async () => {
        btn.classList.add("is-spinning")
        const pool = await ensurePool()
        renderShards(pickDiverseFour(pool), true)
        window.setTimeout(() => btn.classList.remove("is-spinning"), 360)
      })
    }

    if (!window.__tingHomeShardsBound) {
      window.__tingHomeShardsBound = true
      document.addEventListener("astro:page-load", bootHomeShards)
    }
    bootHomeShards()
  </script>
</BaseLayout>
