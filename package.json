{
  "name": "my-brain-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 node scripts/sync-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/sync-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=6144' astro build && npx pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "astro": "^5.17.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.21",
    "mermaid": "^11.4.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.2.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.2"
  }
}
